# Copy this file to .env and change the secret values before running the app.
# Never commit a real .env file.

FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=
JWT_SECRET_KEY=

# SQLite path is relative to the backend folder.
DATABASE_URL=sqlite:///attendance.db

# Frontend origin allowed to call the API
CORS_ORIGINS=http://localhost:5173

# How often the live QR code rotates (seconds)
QR_TTL_SECONDS=20

# OpenCV SFace cosine similarity threshold (higher = stricter)
FACE_MATCH_THRESHOLD=0.363

# Students at or above this percent are marked eligible on reports
ATTENDANCE_ELIGIBILITY_PERCENT=75

# Seed users receive distinct random passwords. Do not reuse these for real accounts.
SEED_ADMIN_EMAIL=admin@sbpcoe.edu
SEED_ADMIN_PASSWORD=
SEED_TEACHER_EMAIL=teacher@sbpcoe.edu
SEED_TEACHER_PASSWORD=
SEED_TEACHER2_PASSWORD=
SEED_STUDENT_EMAIL=student@sbpcoe.edu
SEED_STUDENT_PASSWORD=
SEED_STUDENT2_PASSWORD=
SEED_STUDENT3_PASSWORD=
SEED_STUDENT4_PASSWORD=
